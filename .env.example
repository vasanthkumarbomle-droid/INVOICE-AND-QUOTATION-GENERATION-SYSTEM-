# LedgerFlow Supabase Environment Configuration (Public / Publishable)
# Copy this file to .env and provide your project credentials
# Note: Use only the anon/public key in client-side applications; never use service_role keys.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-publishable-key-here
